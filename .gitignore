.env.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.spec

# Virtual environments
venv/
.venv/
env/
ENV/

# Dataset (download via script)
data/construction-ppe/
data/*.zip

# Model weights (track only intentionally)
models/*.onnx
models/*.ncnn
!models/.gitkeep

# Pose weights auto-downloaded by Ultralytics into the project root
/yolo11*-pose.pt
/yolo*.pt

# Local test / validation media (keep the placeholder, ignore content)
data/validation/*
!data/validation/.gitkeep

# Training artifacts — keep the placeholder, ignore content
outputs/runs/*
!outputs/runs/.gitkeep

# Inference captures — keep the placeholder, ignore content
outputs/captures/*
!outputs/captures/.gitkeep

# Spill de incidentes não entregues à API (fila de reenvio, drenada na subida)
outputs/incidents.jsonl

# Cache de config remota e de apiKey provisionada — a segunda carrega um
# segredo de verdade, nunca deve ir para o repositório.
outputs/camera-config-cache.json
outputs/apikey-cache.json
outputs/dataset-cache-*.json
outputs/zones-config-cache.json
outputs/epi-checklist-cache.json
outputs/orchestrator-logs/

