# Cloudinary — required for capture upload
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: backend API to receive detection events
API_ENDPOINT=http://localhost:3000/api/detections

# Chave de API do pipeline, por camera — enviada como header X-Cypher-Key
# em cada incidente. Ver notify.api_key_env em config/pose_config.yaml.
CYPHER_KEY_CAM01=
